{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lobrzut/netdash/deploy/qnap/qnap-compose.schema.json",
  "title": "NetDash QNAP Docker Compose 2.4",
  "description": "Permissive schema for QNAP Container Station compose (Compose 2.4 service-level resource limits).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.4", "2.3", "2.2", "2.1", "2.0", "2", "3", "3.0", "3.1", "3.2", "3.3", "3.4", "3.5", "3.6", "3.7", "3.8", "3.9"]
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/service"
      }
    },
    "networks": { "type": "object", "additionalProperties": true },
    "volumes": { "type": "object", "additionalProperties": true },
    "secrets": { "type": "object", "additionalProperties": true },
    "configs": { "type": "object", "additionalProperties": true }
  },
  "required": ["services"],
  "definitions": {
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "type": "string" },
        "container_name": { "type": "string" },
        "restart": { "type": "string" },
        "mem_limit": { "type": ["string", "number"] },
        "mem_reservation": { "type": ["string", "number"] },
        "memswap_limit": { "type": ["string", "number"] },
        "cpus": { "type": ["number", "string"] },
        "cpu_shares": { "type": ["integer", "string"] },
        "cpu_quota": { "type": ["integer", "string"] },
        "cpu_period": { "type": ["integer", "string"] },
        "pids_limit": { "type": ["integer", "string"] },
        "ports": { "type": "array" },
        "environment": { "type": ["object", "array"] },
        "volumes": { "type": "array" },
        "cap_add": { "type": "array" },
        "labels": { "type": ["object", "array"] },
        "healthcheck": { "type": "object", "additionalProperties": true },
        "profiles": { "type": "array", "items": { "type": "string" } },
        "deploy": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
