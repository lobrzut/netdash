# Skopiuj do .env (install.sh tworzy .env z losowym SECRET_KEY i hasłem changeme)
NETDASH_SECRET_KEY=wygeneruj-losowy-klucz-min-32-znaki
NETDASH_DEFAULT_ADMIN_PASSWORD=changeme
NETDASH_DEFAULT_ADMIN_USER=admin
NETDASH_SYNC_ADMIN_PASSWORD=true
# NETDASH_LISTEN_PORT=18787

# Tylko gdy skan LAN nie działa (bridge / QNAP bez host network):
# NETDASH_SCAN_CIDR=192.168.1.0/24
# Słaby sprzęt homelab (RPi, stary PC, NAS): węższy CIDR + safe mode (domyślnie true):
# NETDASH_SCAN_CIDR=192.168.1.0/28
# NETDASH_SCAN_SAFE_MODE=true
# Dashboard + skan na żądanie (domyślnie w aplikacji; docs/SCANNING.md):
# NETDASH_DISCOVERY_POLICY=on_demand
# NETDASH_DISCOVERY_ENABLED=false
# NETDASH_SCAN_PORT_PROFILE=popular

# Auto-update (profil auto-update):
# WATCHTOWER_POLL_INTERVAL=86400
