[Unit]
Description=NetDash health watchdog (Docker)
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
Environment=NETDASH_DIR=/opt/netdash
Environment=NETDASH_LISTEN_PORT=18787
Environment=NETDASH_HEALTH_URL=http://127.0.0.1:18787/api/health
ExecStart=/opt/netdash/deploy/netdash-watchdog.sh
