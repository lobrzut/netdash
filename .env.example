# =============================================================================
# NetDash — .env.example (skopiuj do .env, NIE commituj .env)
# =============================================================================
#
# PROFIL LOKALNY (Windows/Linux, python run.py / start.ps1 / start.sh):
#   - NETDASH_SECRET_KEY opcjonalny (domyślny z config.py na dev)
#   - Pierwszy start bez użytkowników w DB: login admin / changeme
#   - NETDASH_SCAN_CIDR zwykle NIE potrzebne — skan LAN działa natywnie
#
# PROFIL SERWER (Docker na Linux, docker compose up):
#   - NETDASH_SECRET_KEY WYMAGANY (losowy ≥32 znaki)
#   - Ustaw NETDASH_DEFAULT_ADMIN_PASSWORD na silne hasło (panel jest wystawiony w LAN);
#     zmiana hasła w UI jest też trwała i nie jest nadpisywana przy restarcie (v1.3.131+)
#   - network_mode: host w docker-compose.yml → skan LAN bez CIDR
#   - bez host mode: odkomentuj NETDASH_SCAN_CIDR poniżej
#
# =============================================================================

# --- Wymagane w produkcji (docker compose up) ---
NETDASH_SECRET_KEY=wygeneruj-losowy-klucz-min-32-znaki
# ZMIEŃ na silne hasło przed wystawieniem (panel słucha na całym LAN przez network_mode: host).
NETDASH_DEFAULT_ADMIN_PASSWORD=changeme
NETDASH_DEFAULT_ADMIN_USER=admin
# Synchronizuj hasło admina z env przy każdym starcie kontenera (homelab: true).
# Zmiana hasła w UI jest zapamiętywana i NIE jest nadpisywana przy restarcie (v1.3.131+).
# Aby wymusić powrót do hasła z env, użyj jednorazowo NETDASH_RESET_ADMIN_PASSWORD poniżej.
NETDASH_SYNC_ADMIN_PASSWORD=true

# --- Jednorazowy reset hasła admina (alternatywa, v1.3.78+) ---
# NETDASH_RESET_ADMIN_PASSWORD=changeme

# --- Opcjonalne ---
# Zainstaluj z przykładowymi kafelkami demo (tylko na pustej bazie przy pierwszym starcie).
# Usunięcie później: scripts/cleanup_demo_data.py --apply
# NETDASH_SEED_DEMO=true
# Domyślny port 18787 (unika kolizji z Readarr 8787). Używaj NETDASH_LISTEN_PORT (nie NETDASH_PORT).
# NETDASH_LISTEN_PORT=18787
# NETDASH_BUILD_DATE=2026-06-11
# NETDASH_IMAGE_TAG=latest
# WATCHTOWER_POLL_INTERVAL=86400

# --- Zaawansowane: aktualizacja z portalu (wymaga docker.sock — docs/QNAP.md) ---
# NETDASH_UPDATE_APPLY_ENABLED=true
# NETDASH_DOCKER_SOCKET=/var/run/docker.sock
# NETDASH_CONTAINER_NAME=netdash

# --- Tylko Docker bridge (bez network_mode: host) ---
# NETDASH_SCAN_CIDR=192.168.1.0/24
# Słaby sprzęt homelab (RPi, stary PC, NAS): mniejszy CIDR, np. /28:
# NETDASH_SCAN_CIDR=192.168.1.0/28
# Tryb bezpieczny skanu — domyślnie true (v1.3.94+). Wyłącz tylko na mocnym hoście:
# NETDASH_SCAN_SAFE_MODE=true
# Wyłącz lokalny skan na dashboardzie (QNAP) — użyj agenta zdalnego deploy/agent:
# NETDASH_SCAN_DISABLED=true

# --- Deploy na serwer Linux (deploy/install.ps1, deploy/install.sh) ---
# NETDASH_SSH_HOST=user@your-server
# NETDASH_SSH_PASSWORD=
# NETDASH_SSH_HOSTKEY=ssh-ed25519 255 ...
# (BRAIN_SSH_* aliases also supported for backward compatibility)
