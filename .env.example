# =============================================================================
# NetDash — .env.example (skopiuj do .env, NIE commituj .env)
# =============================================================================
#
# PROFIL LOKALNY (Windows/Linux, python run.py / start.ps1 / start.sh):
#   - NETDASH_SECRET_KEY opcjonalny (domyślny z config.py na dev)
#   - Pierwszy start bez użytkowników w DB: login admin / changeme
#   - NETDASH_SCAN_CIDR zwykle NIE potrzebne — skan LAN działa natywnie
#
# PROFIL SERWER (Docker na Linux, docker compose up):
#   - NETDASH_SECRET_KEY WYMAGANY (losowy ≥32 znaki)
#   - Ustaw NETDASH_DEFAULT_ADMIN_PASSWORD na silne hasło (panel jest wystawiony w LAN);
#     zmiana hasła w UI jest też trwała i nie jest nadpisywana przy restarcie (v1.3.131+)
#   - network_mode: host w docker-compose.yml → skan LAN bez CIDR
#   - bez host mode: odkomentuj NETDASH_SCAN_CIDR poniżej
#
# =============================================================================

# --- Wymagane w produkcji (docker compose up) ---
NETDASH_SECRET_KEY=wygeneruj-losowy-klucz-min-32-znaki
# ZMIEŃ na silne hasło przed wystawieniem (panel słucha na całym LAN przez network_mode: host).
NETDASH_DEFAULT_ADMIN_PASSWORD=changeme
NETDASH_DEFAULT_ADMIN_USER=admin
# Synchronizuj hasło admina z env przy każdym starcie kontenera (homelab: true).
# Zmiana hasła w UI jest zapamiętywana i NIE jest nadpisywana przy restarcie (v1.3.131+).
# Aby wymusić powrót do hasła z env, użyj jednorazowo NETDASH_RESET_ADMIN_PASSWORD poniżej.
NETDASH_SYNC_ADMIN_PASSWORD=true

# --- Jednorazowy reset hasła admina (alternatywa, v1.3.78+) ---
# NETDASH_RESET_ADMIN_PASSWORD=changeme

# --- Opcjonalne ---
# Zainstaluj z przykładowymi kafelkami demo (tylko na pustej bazie przy pierwszym starcie).
# Usunięcie później: scripts/cleanup_demo_data.py --apply
# NETDASH_SEED_DEMO=true
# Domyślny port 18787 (unika kolizji z Readarr 8787). Używaj NETDASH_LISTEN_PORT (nie NETDASH_PORT).
# NETDASH_LISTEN_PORT=18787
# Polityka discovery (zalecane: on_demand — bez TCP w tle). Legacy adaptive:
# NETDASH_DISCOVERY_POLICY=on_demand
# NETDASH_DISCOVERY_MODE=local
# NETDASH_BUILD_DATE=2026-06-11
# NETDASH_IMAGE_TAG=latest
# WATCHTOWER_POLL_INTERVAL=86400

# --- Watchtower (Dockge stack) ---
# dockge/compose.yaml uses nickfedor/watchtower:1.7.1 (Docker 29+, API 1.44+).
# Older composes may use containrrr/watchtower.
#
# Watchtower holds docker.sock; the panel only asks it to update over HTTP.
# The "Update now" button is OFF until you set BOTH lines below — shipping an
# HTTP API with a default placeholder token would be a backdoor, not a feature.
# The API listens on 127.0.0.1:18080 only; never publish that port.
#
# Generate a token:  openssl rand -hex 32
# WATCHTOWER_HTTP_API_UPDATE=true
# WATCHTOWER_HTTP_TOKEN=
#
# WATCHTOWER_POLL_INTERVAL feeds both Watchtower and the interval NetDash shows,
# so the two cannot drift apart. Default 86400 (once a day).
# Override the endpoint only if you moved the port:
# NETDASH_WATCHTOWER_API_URL=http://127.0.0.1:18080/v1/update

# --- Zaawansowane: aktualizacja z portalu przez docker.sock (alternatywa — docs/QNAP.md) ---
# NETDASH_UPDATE_APPLY_ENABLED=true
# NETDASH_DOCKER_SOCKET=/var/run/docker.sock
# NETDASH_CONTAINER_NAME=netdash

# --- Kafelek "Sieć" (LAN/WAN/wykresy) — włącz w Ustawienia → Wygląd ---
# WAN/GeoIP przez ip-api.com. Wyłącz zewnętrzny lookup (zostaw tylko LAN), jeśli nie chcesz:
# NETDASH_NETWORK_WAN_LOOKUP=false

# --- Tylko Docker bridge (bez network_mode: host) ---
# NETDASH_SCAN_CIDR=192.168.1.0/24
# Słaby sprzęt homelab (RPi, stary PC, NAS): mniejszy CIDR, np. /28:
# NETDASH_SCAN_CIDR=192.168.1.0/28
# --- Automatyczne discovery (skan w tle, niski priorytet) ---
# NETDASH_DISCOVERY_MODE=adaptive
# Sieci do skanu w tle — ustaw też w UI: Ustawienia → Automatyczne discovery
# NETDASH_SCAN_CIDR=192.168.1.0/24
# Sonduj żywe hosty po pełnej liście portów usług (~190) — stopniowo, tylko auto-discovery:
# NETDASH_AUTO_DISCOVERY_ALL_PORTS=true
# Nigdy nie skanuj pełnego /24 w jednym cyklu (chunki /28, domyślnie włączone):
# NETDASH_AUTO_DISCOVERY_ALWAYS_CHUNK=true
# NETDASH_AUTO_DISCOVERY_CHUNK_PREFIX=28
# Zawsze sonduj ważne hosty (np. Proxmox) poza rotacją chunków:
# NETDASH_ARP_EXTRA_HOSTS=192.168.1.200

# --- Skan ręczny (przycisk „Skanuj sieć” / Opcje skanu) ---
# Tryb bezpieczny — domyślnie true. Throttling IPS-friendly; od v1.3.151 NIE blokuje ręcznego /24.
# NETDASH_SCAN_SAFE_MODE=true
# Profil listy portów (v1.3.154+): safe (domyślnie ~12) | popular (~45 homelab) | all_listed (~190)
# NETDASH_SCAN_PORT_PROFILE=safe
# Pełna lista portów usług na żywych hostach (≈ all_listed; NIE skanuje 1–65535):
# NETDASH_SCAN_ALL_PORTS=true
# Ręczny skan pełnego CIDR z ustawień (domyślnie true). false = stary limit max /28:
# NETDASH_MANUAL_SCAN_ALLOW_FULL_CIDR=true
# Twarde limity skanu ręcznego (działają nawet gdy SCAN_SAFE_MODE=false):
# NETDASH_MANUAL_SCAN_MAX_HOSTS=256
# NETDASH_MANUAL_SCAN_MIN_PREFIX=24
# NETDASH_MANUAL_SCAN_MAX_CONCURRENCY=32
# NETDASH_MANUAL_SCAN_MAX_DURATION=1800
# NETDASH_MANUAL_SCAN_TIMEOUT_PER_HOST=6
# Cap budżetu skanu ręcznego (v1.3.155+: domyślnie 7200 — popular+/IPS na /24):
# NETDASH_MANUAL_SCAN_TIMEOUT_CAP=7200
# NETDASH_MANUAL_SCAN_INTERNAL_CHUNK=true
# NETDASH_MANUAL_SCAN_WORK_CHUNK_PREFIX=28
# Wyłącz lokalny skan na dashboardzie — użyj agenta zdalnego deploy/agent:
# NETDASH_SCAN_DISABLED=true

# --- Tryb IPS-friendly / stealth (anty-blokada Symantec SEP i innych IPS) ---
# IPS/antywirus na komputerach w LAN (np. Symantec Endpoint Protection) blokują źródłowe IP,
# gdy zobaczą wiele RÓŻNYCH portów sondowanych na TYM SAMYM hoście w krótkim czasie
# ("The client will block traffic from IP address … for the next 600 seconds").
# NetDash najmocniej wyzwalał to przy skanie ~190 portów usług na jednym żywym hoście naraz.
# Tryb IPS-friendly rozkłada porty jednego hosta w czasie: 1 port naraz, losowa kolejność,
# odstęp z jitterem — dzięki temu żaden host nie widzi „burzy" portów. Skan wielu hostów
# równolegle działa dalej (każdy host sondowany łagodnie). Domyślnie WŁĄCZONY.
# NETDASH_IPS_FRIENDLY=true
# Ile portów naraz do JEDNEGO hosta (1 = ściśle jeden na raz — najbezpieczniej):
# NETDASH_PORT_PARALLEL_PER_HOST=1
# Odstęp (s) między kolejnymi sondami TEGO SAMEGO hosta — zwiększ (np. 0.6–1.0), jeśli SEP nadal blokuje:
# NETDASH_PORTS_PER_HOST_DELAY=0.3
# Dodatkowy losowy jitter (0..N s) doliczany do odstępu — ukrywa stałe tempo:
# NETDASH_PORTS_PER_HOST_JITTER=0.2
# Losowa kolejność portów (sekwencja 22,23,25… jest łatwa do wykrycia przez IPS):
# NETDASH_SCAN_RANDOMIZE_PORTS=true
# Uwaga: gdy NETDASH_IPS_FRIENDLY=false wraca stare, szybkie (i wyzwalające IPS) zachowanie.

# NETDASH_HEALTH_OFFLINE_AFTER_FAILURES=2
# Auto-usuwanie serwisów offline (0 = wyłączone). UI w Ustawienia → Skanowanie ma pierwszeństwo gdy > 0.
# NETDASH_STALE_REMOVE_DAYS=7

# --- Discovery policy (v1.3.150+) — prefer over DISCOVERY_MODE ---
# NETDASH_DISCOVERY_POLICY=on_demand   # zalecane z SEP: tylko skan ręczny „Skanuj sieć”
# NETDASH_DISCOVERY_POLICY=passive     # lekki odczyt ARP co NETDASH_PASSIVE_INTERVAL
# NETDASH_DISCOVERY_POLICY=scheduled   # jeden cykl dziennie: NETDASH_DISCOVERY_SCHEDULE=03:00
# NETDASH_DISCOVERY_POLICY=adaptive    # legacy — ciągły TCP w tle (niezalecane z Symantec SEP)
# NETDASH_DISCOVERY_SCHEDULE=03:00
# NETDASH_PASSIVE_INTERVAL=600

# --- Kill switch + ultra-safe 2 GB VM (Proxmox + Dockge) ---
# NETDASH_DISCOVERY_ENABLED=false   # OFF dla on_demand; true tylko dla scheduled/passive/adaptive
# NETDASH_WEAK_DUAL_CHUNK=false     # jeden /28 na cykl (nie dwa naraz)
# NETDASH_STARTUP_ENRICH_ENABLED=false  # bez pingowania 100+ hostow przy starcie
# NETDASH_DISCOVERY_STARTUP_DELAY=300   # 5 min po starcie zanim pierwszy cykl (gdy wlaczysz discovery)

# =============================================================================
# PROFIL ULTRA-SAFE 2 GB VM — wklej do .env PRZED restartem VM
# =============================================================================
# dockge/compose.yaml: limit 512M, discovery OFF, enrich OFF, all_ports OFF.
# Po stabilnym starcie mozesz wlaczyc discovery recznie (NETDASH_DISCOVERY_ENABLED=true).
#
# NETDASH_SECRET_KEY=<twoj-losowy-klucz-32-znaki>
# NETDASH_DEFAULT_ADMIN_PASSWORD=<silne-haslo>
# NETDASH_SCAN_CIDR=192.168.1.0/24
# NETDASH_DISCOVERY_POLICY=on_demand
# NETDASH_DISCOVERY_ENABLED=false
# NETDASH_DISCOVERY_PROFILE=weak
# NETDASH_DISCOVERY_INTERVAL=900
# NETDASH_DISCOVERY_STARTUP_DELAY=300
# NETDASH_STARTUP_ENRICH_ENABLED=false
# NETDASH_WEAK_DUAL_CHUNK=false
# NETDASH_AUTO_DISCOVERY_ALL_PORTS=false
# NETDASH_AUTO_DISCOVERY_ALWAYS_CHUNK=true
# NETDASH_SCAN_SAFE_MODE=true

# =============================================================================
# PROFIL ZBALANSOWANY 2 GB VM (Proxmox + Dockge) — dashboard + skan na żądanie
# =============================================================================
# Zalecany dla dedykowanej VM 2 GB RAM / 1–2 vCPU. Kontener 512M w dockge/compose.yaml.
# Crashe na homelabie to zwykle obciążenie stosu sieciowego (conntrack), nie brak RAM na VM.
# on_demand = brak TCP w tle; „Skanuj sieć” gdy chcesz inwentarz (docs/SCANNING.md).
#
# NETDASH_SECRET_KEY=<twoj-losowy-klucz-32-znaki>
# NETDASH_DEFAULT_ADMIN_PASSWORD=<silne-haslo>
# NETDASH_SCAN_CIDR=192.168.1.0/24
# NETDASH_DISCOVERY_POLICY=on_demand
# NETDASH_DISCOVERY_ENABLED=false
# NETDASH_DISCOVERY_MODE=local
# NETDASH_STARTUP_ENRICH_ENABLED=false
# NETDASH_WEAK_DUAL_CHUNK=false
# NETDASH_AUTO_DISCOVERY_ALL_PORTS=false
# NETDASH_AUTO_DISCOVERY_ALWAYS_CHUNK=true
# NETDASH_SCAN_SAFE_MODE=true
# NETDASH_SCAN_PORT_PROFILE=popular
# NETDASH_IMAGE_TAG=latest

# =============================================================================
# PROFIL 4 GB+ VM (Proxmox + Dockge) — opcjonalny legacy adaptive (niezalecane z SEP)
# =============================================================================
# VM ma ≥4 GB RAM: host OOM przy 512M jest mało prawdopodobny, ale skan w network_mode: host
# nadal obciąża stos sieciowy hosta (conntrack, flood TCP) — trzymaj SCAN_SAFE_MODE=true.
# W compose.yaml podnieś limit kontenera do 1024M (domyślnie 512M pod 2 GB VM).
# Profil auto + SCAN_SAFE_MODE=true zawsze wybiera weak — ustaw DISCOVERY_PROFILE=normal.
#
# NETDASH_SECRET_KEY=<twoj-losowy-klucz-32-znaki>
# NETDASH_DEFAULT_ADMIN_PASSWORD=<silne-haslo>
# NETDASH_SCAN_CIDR=192.168.1.0/24
# NETDASH_DISCOVERY_ENABLED=true
# NETDASH_DISCOVERY_MODE=adaptive
# NETDASH_DISCOVERY_PROFILE=normal
# NETDASH_DISCOVERY_INTERVAL=180
# NETDASH_DISCOVERY_STARTUP_DELAY=120
# NETDASH_STARTUP_ENRICH_ENABLED=true
# NETDASH_WEAK_DUAL_CHUNK=false
# NETDASH_AUTO_DISCOVERY_ALL_PORTS=true
# NETDASH_AUTO_DISCOVERY_ALWAYS_CHUNK=true
# NETDASH_SCAN_SAFE_MODE=true
# NETDASH_ARP_EXTRA_HOSTS=192.168.1.200

# --- Pomnia tile (optional; Settings → Widgets also stores URL + token in DB) ---
# Bearer for GET /stats or /healthz. Prefer UI token; env is Dockge fallback.
# Do NOT commit real tokens. NETDASH_BRAIN_TOKEN remains a legacy alias.
# NETDASH_POMNIA_TOKEN=
# NETDASH_BRAIN_TOKEN=

# --- Deploy na serwer Linux (deploy/install.ps1, deploy/install.sh) ---
# NETDASH_SSH_HOST=user@your-server
# NETDASH_SSH_PASSWORD=
# NETDASH_SSH_HOSTKEY=ssh-ed25519 255 ...
# (BRAIN_SSH_* aliases also supported for backward compatibility)
