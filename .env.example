# =============================================================================
# NetDash — .env.example (skopiuj do .env, NIE commituj .env)
# =============================================================================
#
# PROFIL LOKALNY (Windows/Linux, python run.py / start.ps1 / start.sh):
#   - NETDASH_SECRET_KEY opcjonalny (domyślny z config.py na dev)
#   - Pierwszy start bez użytkowników w DB: login admin / changeme
#   - NETDASH_SCAN_CIDR zwykle NIE potrzebne — skan LAN działa natywnie
#
# PROFIL SERWER (Docker na Linux, docker compose up):
#   - NETDASH_SECRET_KEY WYMAGANY (losowy ≥32 znaki)
#   - Hasło domyślne: admin / changeme — ZMIEŃ po pierwszym logowaniu (Ustawienia → Hasło)
#   - network_mode: host w docker-compose.yml → skan LAN bez CIDR
#   - bez host mode: odkomentuj NETDASH_SCAN_CIDR poniżej
#
# =============================================================================

# --- Wymagane w produkcji (docker compose up) ---
NETDASH_SECRET_KEY=wygeneruj-losowy-klucz-min-32-znaki
NETDASH_DEFAULT_ADMIN_PASSWORD=changeme

# --- Opcjonalne ---
# Domyślny port 18787 (unika kolizji z Readarr 8787 i typowymi homelab portami).
# Istniejące instalacje na 8787: ustaw NETDASH_PORT=8787 do czasu migracji.
# NETDASH_PORT=18787
NETDASH_DEFAULT_ADMIN_USER=admin
# NETDASH_BUILD_DATE=2026-06-11
# NETDASH_IMAGE_TAG=latest
# WATCHTOWER_POLL_INTERVAL=86400

# --- Zaawansowane: aktualizacja z portalu (wymaga docker.sock — docs/QNAP.md) ---
# NETDASH_UPDATE_APPLY_ENABLED=true
# NETDASH_DOCKER_SOCKET=/var/run/docker.sock
# NETDASH_CONTAINER_NAME=netdash

# --- Tylko Docker bridge (bez network_mode: host) ---
# NETDASH_SCAN_CIDR=192.168.1.0/24

# --- Deploy na serwer Linux (deploy/install.ps1, deploy/install.sh) ---
# NETDASH_SSH_HOST=user@your-server
# NETDASH_SSH_PASSWORD=
# NETDASH_SSH_HOSTKEY=ssh-ed25519 255 ...
# (BRAIN_SSH_* aliases also supported for backward compatibility)
